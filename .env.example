# MercuryMail 环境变量配置 v14.0
# 复制为 .env 后按实际环境修改。deploy.sh 会自动补全缺失项。
# docker compose 启动前必须存在 .env 文件（可从本文件复制）。

# ── 基础与数据库 ──
DATABASE_URL=postgresql+asyncpg://CHANGE_ME:CHANGE_ME@CHANGE_ME:5432/CHANGE_ME
REDIS_URL=redis://CHANGE_ME:6379/0
# 生产环境建议设置强密码；留空则 Redis 无认证（deploy.sh 首次生成 .env 时会自动随机生成）
REDIS_PASSWORD=
POSTGRES_PASSWORD=CHANGE_ME
PG_ADMIN_USER=admin
PG_ADMIN_PASSWORD=CHANGE_ME
SECRET_KEY=CHANGE_ME_AT_LEAST_32_CHARS
ENCRYPTION_KEY=CHANGE_ME
SENDGRID_API_KEY=CHANGE_ME
SENDGRID_WEBHOOK_VERIFICATION_KEY=CHANGE_ME
# 今日 SendGrid 配额展示上限（仅仪表板展示，不参与发送限流）
# 设为 0 表示不启用每日配额限制，仪表板将隐藏「今日配额使用」卡片
SENDGRID_DAILY_QUOTA=0

# ── 管理员 ──
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME
RESET_ADMIN_PASSWORD=false
SUPERADMIN_USERNAME=superadmin
SUPER_ADMIN_USERNAME=superadmin

# ── 应用 ──
APP_ENV=production
ACCESS_TOKEN_EXPIRE_MINUTES=720
PUBLIC_BASE_URL=https://CHANGE_ME
FRONTEND_HTTP_PORT=80
CORS_ORIGINS=
OPENAI_API_KEY=CHANGE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# ── 并发与性能（面向 16H32G 默认配置）──
GLOBAL_MAX_CONCURRENCY=768
TASK_MAX_CONCURRENCY_RATIO=0.8
# 部署模式：单台 VPS 使用 single，只有多个应用实例共享任务时才使用 multi
DEPLOYMENT_MODE=single
# 任务速率限制模式：仅支持 smooth（GCRA 平滑限速）
TASK_RATE_LIMITER_MODE=smooth
# PID 每 5 秒评估一次；扩容采用小步调节，429 时快速降载
PID_INTERVAL_SECONDS=5
PID_KP=0.55
PID_KI=0.08
PID_KD=0.12
PID_RAMP_UP_MAX_STEP=12
PID_429_REDUCE_RATIO=0.70
# 通道认证失败后的快速探测间隔与暂停标记 TTL
CHANNEL_AUTH_PROBE_INTERVAL_SECONDS=30
CHANNEL_AUTH_PAUSE_TTL_SECONDS=3600
# 临时发送错误最大重试次数
SEND_TEMPORARY_MAX_RETRIES=5
# SenderPool 常驻事件循环线程数；多任务高 RTT 发送默认 64，上限 128
SENDER_POOL_WORKERS=64
SENDER_POOL_MAX_WORKERS=128
TASK_HTTP_BATCH_CONCURRENCY_CAP=128
TASK_STATUS_LOG_INTERVAL=30
REDIS_MAX_CONNECTIONS=128
REDIS_LOCK_MAX_CONNECTIONS=128
REDIS_BACKGROUND_MAX_CONNECTIONS=128
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
WRITER_MAX_FLUSHES_PER_SECOND=20
GC_GENERATION0_THRESHOLD=50000
ENABLE_PID_CONCURRENCY_TUNING=true
ENABLE_FEEDFORWARD_CONCURRENCY=true
ENABLE_QUEUE_AWARE_CONCURRENCY=true
PERF_DEBUG=false
DEBUG_SEND_LOG_VARIABLES=false

# ── 智能导出（大数据量自动异步）──
EXPORT_ASYNC_ROW_THRESHOLD=5000000
EXPORT_ASYNC_DIR=/tmp/mercury_exports
EXPORT_ASYNC_MAX_TASKS=3
EXPORT_ASYNC_FILE_TTL_HOURS=24

# ── 定时启动重试（通道占用 / 全局槽位满）──
SCHEDULED_START_RETRY_INTERVAL_SECONDS=60
SCHEDULED_START_RETRY_MAX_ATTEMPTS=3

# ── 数据库连接池 ──
# 16H32G 默认主池 60、突发连接 20；统计、writer、claim 使用独立小池
DB_POOL_SIZE=60
DB_MAX_OVERFLOW=20
POSTGRES_MAX_CONNECTIONS=300

# ── 发送与 HTTP 批量 ──
# 默认 HTTP 批次大小：任务启动时读取并冻结，运行中不可变，PID 仅调整并发数
DEFAULT_HTTP_BATCH_SIZE=100
# 兼容部署脚本使用的配置名；含义同上，运行中不可被 PID 修改
SEND_HTTP_BATCH_SIZE=100
# 每个任务独立的本地并发上限；任务之间不共享槽位，也不存在全局发送并发限制
TASK_DEFAULT_MAX_CONCURRENCY=100
WARMUP_DEFAULT_HTTP_BATCH_SIZE=20
ESTIMATED_PROXY_RTT_SECONDS=1.0
ENABLE_SENDGRID_KEEPALIVE=true
ENABLE_SENDGRID_HTTP2=true
# 发送总预算：队列等待固定 5 秒，HTTP 请求预算为总预算减 5 秒（默认 25 秒）
SEND_EMAIL_TIMEOUT_SECONDS=30
SEND_EMAIL_QUEUE_WAIT_BUDGET_SECONDS=5

# ── 异步写入 ──
# 最小结果账本关键队列：满时阻塞，结果绝不丢弃
CRITICAL_WRITER_QUEUE_MAXSIZE=100000
# 详细诊断日志队列：满时允许丢弃并输出限频中文告警
DETAIL_WRITER_QUEUE_MAXSIZE=500000
WRITER_BATCH_SIZE=300
WRITER_TURBO_BATCH_SIZE=1000
IMPORT_PREPROCESS_WORKERS=4

# ── 日志归档与 Event Poller ──
HOT_RETENTION_DAYS=3
ARCHIVE_RETENTION_DAYS=30
LOST_EVENT_RETENTION_DAYS=14
# SendGrid Event Poller 拉取间隔（秒），默认 120；生产建议 60~180
POLL_INTERVAL_SECONDS=120

# ── 部署 ──
CLEAN_SOURCE_AFTER_DEPLOY=false

# ── 变量说明 ──
# ENCRYPTION_KEY                 生产环境必填，否则服务拒绝启动（无硬编码 fallback）
# SECRET_KEY                     生产环境必填，至少 32 字符
# ADMIN_PASSWORD                 初始普通管理员密码（≥8 字符）；仅首次创建普通管理员或 RESET_ADMIN_PASSWORD=true 时写入数据库；deploy.sh 留空时自动生成
# RESET_ADMIN_PASSWORD           默认 false；仅设为 true 时，启动阶段才会用 ADMIN_PASSWORD 强制重置已有普通管理员密码
# REDIS_PASSWORD                 Redis 认证密码；留空则无认证；首次 deploy.sh 自动生成 .env 时会写入随机值
# SUPERADMIN_USERNAME            隐藏超级管理员用户名（优先于 SUPER_ADMIN_USERNAME）
# POSTGRES_PASSWORD              须与 DATABASE_URL、docker-compose db 服务一致
# PUBLIC_BASE_URL                对外访问地址（Nginx 前端，默认 http://服务器IP）
# FRONTEND_HTTP_PORT             宿主机映射 Nginx 端口（默认 80；被占用可改 8080）
# GLOBAL_MAX_CONCURRENCY         全局发送协程槽位上限；通用线程池由运行环境独立配置，不再直接映射该值
# TASK_RATE_LIMITER_MODE         任务速率限制模式：smooth（默认平滑）或 burst（允许突发）
# SENDER_POOL_WORKERS            SenderPool 常驻事件循环线程数
# WRITER_MAX_FLUSHES_PER_SECOND  SendLog 异步刷盘最大频率（次/秒）
# GC_GENERATION0_THRESHOLD       Python GC 第 0 代阈值
# ENABLE_PID_CONCURRENCY_TUNING      是否启用 PID 自适应并发调节
# ENABLE_FEEDFORWARD_CONCURRENCY     是否启用前馈项并发下限
# ENABLE_QUEUE_AWARE_CONCURRENCY     是否启用预取/写入队列感知调节
# PERF_DEBUG                         是否开启性能调试日志（含 SendLog 变量快照）
# DEBUG_SEND_LOG_VARIABLES           是否将收件人 substitution 精简快照写入 SendLog.extra_data
# WRITER_TURBO_BATCH_SIZE         SendLog 高负载批量写入大小
# IMPORT_PREPROCESS_WORKERS       收件人导入预解析线程数（默认 4）
# EXPORT_ASYNC_ROW_THRESHOLD       超过此行数自动切换异步后台导出
# EXPORT_ASYNC_DIR               异步导出文件目录
# EXPORT_ASYNC_MAX_TASKS         同时进行的异步导出任务上限
# EXPORT_ASYNC_FILE_TTL_HOURS    异步导出文件保留小时数
# SCHEDULED_START_RETRY_INTERVAL_SECONDS  定时启动通道占用/槽位满重试间隔（秒）
# SCHEDULED_START_RETRY_MAX_ATTEMPTS      定时启动最大重试次数

# 16H32G 单实例发送并发上限；任务仍受各自配置和 PID 控制
GLOBAL_MAX_CONCURRENCY=768
# 单台 VPS 使用 single；multi 才会每 5 秒向 Redis 异步发布本地槽位快照
DEPLOYMENT_MODE=single
# 主数据库池 60+20，writer、claim、dashboard 另有隔离小池
DB_POOL_SIZE=60
DB_MAX_OVERFLOW=20
# SendGrid 同步 SDK 常驻线程数及安全上限
SENDER_POOL_WORKERS=64
SENDER_POOL_MAX_WORKERS=128
# 每任务 HTTP 批量并发安全上限
TASK_HTTP_BATCH_CONCURRENCY_CAP=128
# 任务状态及容量诊断日志周期（秒）
TASK_STATUS_LOG_INTERVAL=30
# PID 参数：5 秒评估，小步扩容，出现 429 时降低到当前并发的 70%
PID_INTERVAL_SECONDS=5
PID_KP=0.55
PID_KI=0.08
PID_KD=0.12
PID_RAMP_UP_MAX_STEP=12
PID_429_REDUCE_RATIO=0.70
# Redis 三类连接池容量与超时；single 模式下协调同步不依赖 Redis
REDIS_MAX_CONNECTIONS=128
REDIS_LOCK_MAX_CONNECTIONS=128
REDIS_BACKGROUND_MAX_CONNECTIONS=128
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30

# HTTP 批次大小在任务启动时冻结；PID 只能调整并发，此开关已永久禁用并仅保留兼容
TASK_HTTP_BATCH_ADAPTIVE_ENABLED=false
# 默认固定批次大小；任务自身配置优先，运行中不可修改
SEND_HTTP_BATCH_SIZE=100
# 每个任务独立的本地并发上限；任务之间不共享槽位，也不存在全局发送并发限制
TASK_DEFAULT_MAX_CONCURRENCY=100

# 通道认证失败后的快速恢复探测间隔（秒）
CHANNEL_PAUSED_CHECK_INTERVAL_SECONDS=30

# 兼容旧配置名；未设置时使用 CHANNEL_PAUSED_CHECK_INTERVAL_SECONDS
CHANNEL_AUTH_PROBE_INTERVAL_SECONDS=30

# 通道认证失败 Redis 暂停标记有效期（秒）
CHANNEL_AUTH_PAUSE_TTL_SECONDS=3600
